# cp .env.example .env  ve kendi ortamınıza göre düzenleyin.

# ---------------- Elasticsearch ----------------
ES_URL=https://elastic.fabrika.local:9200
# Önerilen: sadece okuma yetkili API key (docs/03-elastic-veri.md)
ES_API_KEY=
# veya kullanıcı/parola
ES_USERNAME=
ES_PASSWORD=
# Kurumsal CA sertifikası (self-signed ise)
ES_CA_CERTS=/etc/ssl/certs/elastic-ca.crt
ES_VERIFY_CERTS=true
ES_TIMEOUT=15
CMMS_WO_INDEX=cmms-workorders
# Tek analizde çekilecek maksimum belge (Jetson belleğini korur)
CMMS_MAX_DOCS=50000

# ---------------- Alan eşleştirme (kendi mapping'inize göre) ----------------
CMMS_FIELD_WO_ID=wo_id
CMMS_FIELD_ASSET=asset_id
CMMS_FIELD_ASSET_NAME=asset_name
CMMS_FIELD_LOCATION=location
CMMS_FIELD_TYPE=type
CMMS_FIELD_STATUS=status
CMMS_FIELD_PRIORITY=priority
CMMS_FIELD_FAILURE_CODE=failure_code
CMMS_FIELD_DESCRIPTION=description
CMMS_FIELD_CREATED_AT=created_at
CMMS_FIELD_STARTED_AT=started_at
CMMS_FIELD_COMPLETED_AT=completed_at
CMMS_FIELD_DOWNTIME=downtime_hours
CMMS_FIELD_LABOR=labor_hours
CMMS_FIELD_COST=cost
# Değer eşleştirmeleri (virgülle ayrılmış)
CMMS_CORRECTIVE_VALUES=corrective
CMMS_PREVENTIVE_VALUES=preventive
CMMS_OPEN_STATUS_VALUES=open,in_progress,waiting_parts
CMMS_COMPLETED_STATUS_VALUES=completed,closed

# ---------------- Sensör / durum izleme (opsiyonel) ----------------
# Index yoksa sensor_health aracı "veri yok" der, diğer araçlar etkilenmez.
CMMS_READINGS_INDEX=cmms-readings
CMMS_RFIELD_ASSET=asset_id
CMMS_RFIELD_METRIC=metric
CMMS_RFIELD_VALUE=value
CMMS_RFIELD_TIMESTAMP=@timestamp

# ---------------- Yerel LLM ----------------
# Ollama:     http://localhost:11434/v1
# llama.cpp:  http://localhost:8080/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=cmms-llm
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=400
# schema | json | none  (yapılandırılmış çıktı desteği)
LLM_JSON_MODE=schema

# ---------------- Agent ----------------
# rules = sadece kurallar (en hızlı) | llm = hep LLM | hybrid = önce kural sonra LLM
ROUTER_MODE=hybrid
DEFAULT_DAYS=180
CACHE_TTL_S=120
